
@model IEnumerable<LXR_The_Tavern_Order_Management_System.Models.MenuItem>

@{
    ViewData["Title"] = "Our Menu";
}


<div class="text-center mb-4">

    <img src="~/images/tavern-logo.jpg"
         alt="The Tavern Dine and Drinks Logo"
         class="img-fluid"
         style="max-width: 200px; width: 100%; height: auto;" />

    <h3>Our Food Menu</h3>
    <p>Pick an order and add to cart!</p>

</div>


    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">
            + Add New Menu Item
        </a>

        <a asp-controller="Cart"
           asp-action="Index"
           class="btn btn-primary">
            View Cart
        </a>
    </div>
<div class="mb-3">
    <input type="text"
           id="searchMenu"
           class="form-control"
           placeholder="Search food, drinks, or category...">
</div>
   @foreach (var category in Model.GroupBy(item => item.Category))
{
    <h2 class="fw-bold mt-4 mb-3 border-bottom pb-2">
        @category.Key
    </h2>

    <div class="row menu-category">

        @foreach (var item in category)
        {
            <div class="col-md-4 mb-4 menu-card">

                <div class="card h-100 shadow-sm">

                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl"
                             class="card-img-top"
                             alt="@item.Name"
                             style="height:200px; object-fit:cover;" />
                    }

                    <div class="card-body">

                        <h5 class="card-title">
                            @item.Name
                        </h5>

                        <p class="text-muted">
                            @item.Category
                        </p>

                        <p class="card-text">
                            @item.Description
                        </p>

                        <h5 class="text-success">
                            @item.Price.ToString("C2",
                                System.Globalization.CultureInfo.GetCultureInfo("en-PH"))
                        </h5>

                        @if (item.IsAvailable)
                        {
                            <span class="badge bg-success">
                                Available
                            </span>

                            <form asp-controller="Cart"
                                  asp-action="Add"
                                  method="post"
                                  class="mt-3">

                                <input type="hidden"
                                       name="menuItemId"
                                       value="@item.Id" />

                                <button type="submit" class="btn btn-navy w-100">Add to Cart</button>

                            </form>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Unavailable
                            </span>
                        }

                        <hr />

                        <div class="d-flex justify-content-between">

                            <a asp-action="Edit" asp-route-id="@item.Id"
   class="btn btn-navy btn-sm">Edit</a>

<a asp-action="Details" asp-route-id="@item.Id"
   class="btn btn-navy btn-sm">Details</a>

<a asp-action="Delete" asp-route-id="@item.Id"
   class="btn btn-danger btn-sm">Delete</a>

                        </div>

                    </div>
                </div>
            </div>
                }
    </div>
}
