
@model IEnumerable<LXR_The_Tavern_Order_Management_System.Models.Order>

@{
    ViewData["Title"] = "Orders";
}

<div class="container mt-4 mb-5">

    <h1 class="text-center mb-4">Orders Dashboard</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            No orders have been placed yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover">

                <thead class="table-dark">
                    <tr>
                        <th>Order Number</th>
                        <th>Customer Name</th>
                        <th>Payment Method</th>
                        <th>Order Date</th>
                        <th>Total Amount</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="fw-bold">
                                @order.OrderNumber
                            </td>

                            <td>@order.Name</td>

                            <td>@order.PaymentMethod</td>

                            <td>
                                @order.OrderDate.ToString("MMM dd, yyyy hh:mm tt")
                            </td>

                            <td>
                                ₱@order.TotalAmount.ToString("N2")
                            </td>

                            <td>
                                <a asp-controller="Orders"
                                   asp-action="Confirmation"
                                   asp-route-id="@order.Id"
                                   class="btn btn-primary btn-sm">
                                    View Order
                                </a>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

    <a asp-controller="MenuItems"
       asp-action="Index"
       class="btn btn-secondary">
        Back to Menu
    </a>

</div>
